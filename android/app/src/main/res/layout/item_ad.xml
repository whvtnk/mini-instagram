<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFF8E1"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Жарнама • Sponsored"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginBottom="8dp"/>

    <ImageView
        android:id="@+id/ivAdImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"/>

    <TextView
        android:id="@+id/tvAdTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 Ең жақсы ұсыныс!"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvAdDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Қазір тапсырыс бер — 50% жеңілдік!"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginTop="4dp"/>

    <Button
        android:id="@+id/btnAdClick"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Толығырақ"
        android:backgroundTint="#FF6B00"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

</LinearLayout>